{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-git.py\"",
            "if": "Bash(*git*)",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Conferindo regras de git..."
          }
        ]
      }
    ]
  }
}
