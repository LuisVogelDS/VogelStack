{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-voz.py\"",
            "if": "Bash(*voz.py*)",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Conferindo custo da narracao..."
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-voz.py\"",
            "if": "Bash(*elevenlabs*)",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Conferindo custo da narracao..."
          }
        ]
      }
    ]
  }
}
